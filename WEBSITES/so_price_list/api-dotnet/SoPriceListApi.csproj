<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net8.0 self-contained: the runtime ships with the app, so it does not
         matter which .NET runtimes are installed on the IIS box (the existing
         WebAPI targets net7.0 and we must not disturb it). -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- Declared HERE, not on the publish command line. These used to be passed
         as flags; a publish that forgot them produced a framework-dependent
         build, which IIS rejected at run time with
             HTTP Error 500.31 - Failed to load ASP.NET Core runtime
         because the box has no .NET 8 shared runtime. Keeping them in the
         project means any `dotnet publish` produces a deployable build. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoPriceListApi</RootNamespace>
    <AssemblyName>SoPriceListApi</AssemblyName>
    <!-- Microsoft.Data.SqlClient does not run under invariant globalization. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

</Project>
